# =============================================================================
# LLMCrawl Environment Configuration
# =============================================================================
#
# Copy this file to .env and configure with your credentials
#
# IMPORTANT: This is the ONLY .env file used by services
# Location: deploy/.env (read by docker-compose.yml)
# Documentation: ../CONFIGURATION.md
#
# =============================================================================

# =============================================================================
# LLM CONFIGURATION
# =============================================================================

# API Keys (DEPRECATED - Use Entra ID authentication instead)
# Leave empty or remove when using Entra ID bearer tokens
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Azure Anthropic Configuration (for Claude models)
AZURE_ANTHROPIC_ENDPOINT=https://your-resource.services.ai.azure.com/anthropic/

# LLM Provider Selection
LLM_PROVIDER=azure
# Options: openai, azure

# Chat and Embedding Models
CHAT_MODEL=gpt-4-turbo-preview
EMBED_MODEL=text-embedding-3-large

# =============================================================================
# ENTRA ID AUTHENTICATION (REQUIRED for Azure Foundry API key-less auth)
# =============================================================================

# Configure these to use MSAL authentication in HiChat client
# Azure CLI client ID (has broad permissions without admin consent)
ENTRA_CLIENT_ID=04b07795-8ddb-461a-bbee-02f9e1bf7b46
ENTRA_TENANT_ID=your-tenant-id-here
AZURE_FOUNDRY_SCOPE=https://cognitiveservices.azure.com/.default

# JWT Token Validation (Optional)
# Set to 'true' to validate bearer tokens at gateway, 'false' to pass through
JWT_VALIDATION_ENABLED=false

# Available Models Configuration (JSON array)
# Model is selected by client per request. All models listed here are available.
# Each model: name (API identifier), display_name (shown in UI), deployment_name (Azure deployment),
#             provider_type (openai/anthropic/claude), max_output_tokens (optional, model-specific limit)
# Default max_output_tokens: 16384 for OpenAI, 64000 for Anthropic (Claude)
# provider_type values:
#   "openai"     - Azure OpenAI or direct OpenAI API
#   "anthropic"  - Azure Anthropic endpoint (via Azure Foundry)
#   "claude"     - Claude Code CLI via Claude Bridge (requires CLAUDE_BRIDGE_URL)
LLM_MODELS=[{"name":"gpt-4","display_name":"GPT-4","deployment_name":"gpt-4","provider_type":"openai","max_output_tokens":16384},{"name":"claude-sonnet-4-5","display_name":"Claude Sonnet 4-5","deployment_name":"claude-sonnet-4-5","provider_type":"anthropic","max_output_tokens":64000},{"name":"claude-opus-4-6","display_name":"Claude Opus 4-6","deployment_name":"claude-opus-4-6","provider_type":"claude"}]

# =============================================================================
# TOOL CONFIGURATION
# =============================================================================

# Per-tool call limits (JSON object: {"tool_name": limit, ...})
# Use -1 for unlimited calls
# Available tools:
#   Azure DevOps: search_azure_devops_code, search_azure_devops_files, get_azure_devops_file
#   Crawler: crawl_and_refresh
#   Local MCP: read_local_file, list_files, search_file_content, index_files
#   WCD: query_composition_db
TOOL_ROUND_LIMITS={"search_azure_devops_code":30,"get_azure_devops_file":30,"crawl_and_refresh":20,"read_local_file":50,"list_files":50,"search_file_content":50,"index_files":50,"query_composition_db":-1}

# Default limit for tools not specified in TOOL_ROUND_LIMITS
MAX_TOOL_ROUNDS=5

# Code Intelligence Agent Limits
MAX_FILES_PER_REQUEST=80
MAX_INPUT_TOKENS=100000

# =============================================================================
# AZURE DEVOPS MCP SERVER CONFIGURATION
# =============================================================================
#
# The Azure DevOps MCP server allows the agent to search and read code from
# Azure DevOps repositories.
#
# Setup:
# 1. Create a Personal Access Token (PAT) at:
#    https://dev.azure.com/[your-org]/_usersSettings/tokens
#
# 2. Required PAT scopes:
#    - Code (Read) - for reading repository files
#    - Code (Search) - for searching code (if available)
#
# 3. Set your PAT below:
AZURE_DEVOPS_PAT=your-azure-devops-pat-here

# Default organization, project, and repo (optional, can be overridden per request)
# AZURE_DEVOPS_ORG=microsoft
# AZURE_DEVOPS_PROJECT=OS
# AZURE_DEVOPS_REPO=os.2020
# AZURE_DEVOPS_BRANCH=main

# =============================================================================
# WINDOWS COMPOSITION DATABASE (WCD) TOOL CONFIGURATION
# =============================================================================

# The gateway starts the WCD bridge on demand — no manual startup needed.
# Configure ONE mode below to enable WCD. First match wins (priority order):
#
#   1. WIN_COMP_PS_COMMAND  (highest — direct PowerShell command)
#   2. WIN_COMP_SHARE_CMD   (direct .cmd path)
#   3. WIN_COMP_PATH        (constructs CMD path from base path + arch)
#   4. WCD_BUILD_NAME       (lowest — WCDaaS local auto-detection)

# --- Mode 1: Direct PowerShell command (highest priority) ---
# WIN_COMP_PS_COMMAND=& 'C:\path\to\InteractViaPowershell.ps1' -branch ... -buildName ... -arch amd64

# --- Mode 2: Direct CMD path ---
# WIN_COMP_SHARE_CMD=\\winbuilds\release\...\amd64fre\WindowsCompositionData\SDK\InteractViaPowerShell.cmd

# --- Mode 3: Network share (auto-appends <arch>\WindowsCompositionData\SDK\InteractViaPowerShell.cmd) ---
# WIN_COMP_PATH=\\winbuilds\release\rs_sparc_ctr_exp\29498.1001.251201-1700

# --- Mode 4: WCDaaS local (uses download from %LOCALAPPDATA%\Temp\wcdaas) ---
# WCD_BUILD_NAME=29503.1000.251209-1700
# WCD_BRANCH=rs_sparc_ctr_exp

# --- Shared options (apply to all modes) ---
# WIN_COMP_ARCH=amd64fre            # Architecture folder name (default: amd64fre)
# WCDAAS_FOLDER=                    # Specific WCDaaS folder GUID (auto-detects most recent if blank)

# =============================================================================
# CLAUDE CODE CLI BRIDGE CONFIGURATION
# =============================================================================

# The Claude Bridge exposes Claude Code CLI as an HTTP API for use as an LLM provider.
# This enables models like claude-opus-4-6 to be used via the gateway.
#
# Setup:
# 1. Install Claude Code CLI on your host machine (npm install -g @anthropic-ai/claude-code)
# 2. Start the bridge service:
#    python tools/claude_bridge.py
#    (or: .\scripts\start_claude_bridge.ps1)
#
# 3. Set the bridge URL below (use host.docker.internal to reach the host from Docker):
CLAUDE_BRIDGE_URL=http://host.docker.internal:8006

# =============================================================================
# VECTOR DATABASE CONFIGURATION
# =============================================================================

VECTOR_DB=qdrant
# Options: qdrant, pgvector

QDRANT_URL=http://qdrant:6333
PG_DSN=postgresql://postgres:password@postgres:5432/rag_db

# =============================================================================
# FIRECRAWL CONFIGURATION
# =============================================================================

# Local Firecrawl container (no API key needed)
FIRECRAWL_URL=http://firecrawl:3002

# =============================================================================
# INTERNAL SITE AUTHENTICATION (for crawling authenticated sites)
# =============================================================================
#
# To crawl internal sites that require authentication (e.g., www.osgwiki.com),
# use the llmcrawl auth command:
#
# llmcrawl auth https://www.osgwiki.com/wiki/Main_Page --dir ./llmcrawl-deploy
#
# This will open a browser, let you sign in, and automatically update:
# - ALLOWED_DOMAINS (adds the authenticated domain)
# - FIRECRAWL_AUTH_TYPE=cookies
# - FIRECRAWL_AUTH_STORAGE_STATE (with captured cookies)
#
# Manual configuration (if not using the tool):
FIRECRAWL_AUTH_TYPE=none
# Options: none, cookies, headers, basic, bearer

# The auth tool will populate these automatically:
# FIRECRAWL_AUTH_STORAGE_STATE={"cookies": [...], "origins": [...]}

# =============================================================================
# WEB CRAWLING CONFIGURATION
# =============================================================================

ALLOWED_DOMAINS=sec.gov,ft.com,wsj.com,nvidia.com,reuters.com,bloomberg.com,techcrunch.com
RESPECT_ROBOTS=true
MAX_CONCURRENCY=4
REQUEST_TIMEOUT_MS=20000
USER_AGENT=WebRAG/1.0 (+https://github.com/yourorg/webrag)

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

# Service Hosts (internal Docker network)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
CRAWLER_HOST=0.0.0.0
CRAWLER_PORT=8001
INDEXER_HOST=0.0.0.0
INDEXER_PORT=8002

# Azure DevOps MCP Service URL (internal Docker network)
AZURE_DEVOPS_MCP_URL=http://azure-devops-mcp-server:8004

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_FORMAT=json
# Options: json, text

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# =============================================================================
# MEMORY SERVICE CONFIGURATION
# =============================================================================
#
# The Memory Service provides OpenClaw-style auto-memory with semantic search.
# Daily logs and durable facts are stored as markdown files.
# memsearch library indexes these files and provides semantic search via Milvus.
#
# Path to memory folder (absolute or relative to deploy/)
# Examples:
#   ./memory              - Relative path (resolves to deploy/memory/)
#   C:\logs\llmcrawl      - Absolute Windows path
#   /var/log/llmcrawl     - Absolute Linux path
MEMORY_DATA_PATH=./memory

# Memory service endpoint (runs locally, not in Docker)
MEMORY_SERVICE_URL=http://localhost:8007

# Auto-append all user/assistant messages to daily logs
MEMORY_AUTO_LOG=true

# Auto-trigger 80% context flush with distillation
MEMORY_AUTO_FLUSH=true

# Context threshold for triggering distillation (0.0-1.0)
MEMORY_FLUSH_THRESHOLD=0.8
