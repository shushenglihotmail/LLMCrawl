# Crawler Service Dockerfile
FROM python:3.11-slim

# Install system dependencies for Playwright
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    curl \
    libnss3 \
    libxss1 \
    libasound2 \
    libxtst6 \
    libatspi2.0-0 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libxkbcommon0 \
    libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements/crawler.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Create non-root user and home directory
RUN groupadd -r appuser && useradd -r -g appuser -m appuser

# Install Playwright browsers as appuser
USER appuser
RUN playwright install chromium

# Switch back to root to install system deps for browsers
USER root
RUN playwright install-deps chromium

# Copy application code
COPY crawler/ /app/crawler/

# Create logs and temp directories
RUN mkdir -p /app/logs /tmp/playwright

# Create non-root user
RUN chown -R appuser:appuser /app /tmp/playwright
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Expose port
EXPOSE 8001

# Run the application
CMD ["python", "-m", "uvicorn", "crawler.main:app", "--host", "0.0.0.0", "--port", "8001"]
