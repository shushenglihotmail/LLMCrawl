# LLM Configuration
OPENAI_API_KEY=your_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-01
LLM_PROVIDER=openai
CHAT_MODEL=gpt-4-turbo-preview
EMBED_MODEL=text-embedding-3-large

# Vector Database Configuration
VECTOR_DB=qdrant
QDRANT_URL=http://qdrant:6333
PG_DSN=postgresql://postgres:password@postgres:5432/rag_db

# Firecrawl Configuration
FIRECRAWL_URL=http://firecrawl:3002
FIRECRAWL_API_KEY=your_firecrawl_key_here

# Firecrawl Authentication (Optional - for authenticated sites)
# Cookie-based authentication for Microsoft internal sites
# See tools/msauth/README.md for setup instructions
FIRECRAWL_AUTH_TYPE=none
# FIRECRAWL_AUTH_TYPE=cookies
# AUTH_TEST_URL=https://your-site.com
# FIRECRAWL_AUTH_STORAGE_STATE=<captured_session_state>

# Web Crawling Configuration
ALLOWED_DOMAINS=sec.gov,ft.com,wsj.com,nvidia.com,reuters.com,bloomberg.com,techcrunch.com
RESPECT_ROBOTS=true
MAX_CONCURRENCY=4
REQUEST_TIMEOUT_MS=20000
USER_AGENT=WebRAG/1.0 (+https://github.com/yourorg/webrag)

# Service Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
CRAWLER_HOST=0.0.0.0
CRAWLER_PORT=8001
INDEXER_HOST=0.0.0.0
INDEXER_PORT=8002
MCP_SERVER_URL=http://mcp-server:8003

# Tool Calling Configuration
MAX_TOOL_ROUNDS=5  # Maximum number of sequential tool calls (prevents infinite loops)

# MCP Server Configuration (Local File Operations)
MCP_ROOT_FOLDER=/data/files
MCP_VECTOR_DB_PATH=/data/mcp_vector_db

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Cache Configuration
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600
