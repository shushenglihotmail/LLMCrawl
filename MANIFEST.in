# Include deploy folder and all its contents
include deploy/.env.example
include deploy/docker-compose.yml
include deploy/prometheus.yml
include deploy/Dockerfile.*
recursive-include deploy/requirements *
recursive-include deploy/grafana-provisioning *
recursive-include deploy/data *

# Include static files for hichat
recursive-include clients/hichat/static *

# Include mcp_servers Dockerfiles and non-Python files
include mcp_servers/azure_devops_mcp_server/Dockerfile
include mcp_servers/azure_devops_mcp_server/*.md
include mcp_servers/azure_devops_mcp_server/pyproject.toml

# Include tools
recursive-include tools *

# Include README
include README.md
include INSTALL.md

# Exclude unnecessary files
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .git*
global-exclude .env
exclude deploy/.env
